						Start = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 3, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k == 1 then return 0 end; return (ul(string.sub(s, 1, a)) - 0.5) / len" },
						VerticalJustificationNew = Input { Value = 3 },
