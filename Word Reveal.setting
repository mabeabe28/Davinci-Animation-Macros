						Start = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 11, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k == 1 then return 0 end; return (ul(string.sub(s, 1, a)) - 0.5) / len" },
						VerticalJustificationNew = Input { Value = 3 },
						Style = Input {
							Value = "Bold",
							Expression = "WR_Text1.Style"
						},
						StyledText = Input { Expression = "WR_Text1.StyledText" },
						Opacity1 = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 11, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 0 end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local p = ((time - comp.RenderStart) / fps - WR_Text1.StartDelay - (k - 1) * WR_Text1.WordDelay) / math.max(WR_Text1.FadeIn, 0.01); p = math.min(1, math.max(0, p)); return p * p * (3 - 2 * p)" },
						Red1 = Input { Expression = "WR_Text1.Red1" },
						Green1 = Input { Expression = "WR_Text1.Green1" },
						Blue1 = Input { Expression = "WR_Text1.Blue1" },
						CharacterSpacing = Input { Expression = "WR_Text1.CharacterSpacing" },
						LineSpacing = Input { Expression = "WR_Text1.LineSpacing" },
						Font = Input {
							Value = "Open Sans",
							Expression = "WR_Text1.Font"
						},
						Height = Input { Value = 2160 }
					}
				},
				WR_Blur11 = Blur {
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" } },
						XBlurSize = Input { Expression = "(1 - WR_Text11.Opacity1) * WR_Text1.BlurAmt" },
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Text11"
						}
					}
				},
				WR_Slide11 = Transform {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Blur11"
						},
						Center = Input { Expression = "Point(0.5, 0.5 - ((1 - WR_Text11.Opacity1)^2) * WR_Text1.Rise)" }
					}
				},
				WR_Join11 = Merge {
					Inputs = {
						Background = Input {
							Source = "Output",
							SourceOp = "WR_Join10"
						},
						Foreground = Input {
							Source = "Output",
							SourceOp = "WR_Slide11"
						},
						PerformDepthMerge = Input { Value = 0 }
					}
				},
				WR_Text12 = TextPlus {
					Version = 1,
					Inputs = {
						Width = Input { Value = 3840 },
						Size = Input { Expression = "WR_Text1.Size" },
						Center = Input { Expression = "WR_Text1.Center" },
						UseFrameFormatSettings = Input { Value = 1 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						Wrap = Input { Value = 1 },
						HorizontalJustificationNew = Input { Value = 3 },
						End = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 12, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k >= i then return 1 end; return (ul(string.sub(s, 1, b)) + 0.5) / len" },
						Start = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 12, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k == 1 then return 0 end; return (ul(string.sub(s, 1, a)) - 0.5) / len" },
						VerticalJustificationNew = Input { Value = 3 },
						Style = Input {
							Value = "Bold",
							Expression = "WR_Text1.Style"
						},
						StyledText = Input { Expression = "WR_Text1.StyledText" },
						Opacity1 = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 12, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 0 end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local p = ((time - comp.RenderStart) / fps - WR_Text1.StartDelay - (k - 1) * WR_Text1.WordDelay) / math.max(WR_Text1.FadeIn, 0.01); p = math.min(1, math.max(0, p)); return p * p * (3 - 2 * p)" },
						Red1 = Input { Expression = "WR_Text1.Red1" },
						Green1 = Input { Expression = "WR_Text1.Green1" },
						Blue1 = Input { Expression = "WR_Text1.Blue1" },
						CharacterSpacing = Input { Expression = "WR_Text1.CharacterSpacing" },
						LineSpacing = Input { Expression = "WR_Text1.LineSpacing" },
						Font = Input {
							Value = "Open Sans",
							Expression = "WR_Text1.Font"
						},
						Height = Input { Value = 2160 }
					}
				},
				WR_Blur12 = Blur {
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" } },
						XBlurSize = Input { Expression = "(1 - WR_Text12.Opacity1) * WR_Text1.BlurAmt" },
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Text12"
						}
					}
				},
				WR_Slide12 = Transform {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Blur12"
						},
						Center = Input { Expression = "Point(0.5, 0.5 - ((1 - WR_Text12.Opacity1)^2) * WR_Text1.Rise)" }
					}
				},
				WR_Join12 = Merge {
					Inputs = {
						Background = Input {
							Source = "Output",
							SourceOp = "WR_Join11"
						},
						Foreground = Input {
							Source = "Output",
							SourceOp = "WR_Slide12"
						},
						PerformDepthMerge = Input { Value = 0 }
					}
				},
				WR_Fade = Merge {
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {
							Source = "Output",
							SourceOp = "WR_Clear"
						},
						Foreground = Input {
							Source = "Output",
							SourceOp = "WR_Join12"
						},
						Blend = Input { Expression = "iif(WR_Text1.FadeOut <= 0, 1, min(1, max(0, (comp.RenderEnd + 1 - time) / (WR_Text1.FadeOut * comp:GetPrefs(\"Comp.FrameFormat.Rate\")))))" }
					}
				},
				WR_StopMotion = TimeStretcher {
					UserControls = ordered() {
						StopFPS = {
							LINKID_DataType = "Number",
							INP_Default = 12,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxScale = 60,
							INP_MinScale = 1,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Stop Motion FPS"
						}
					},
					Inputs = {
						SourceTime = Input {
							Value = 0,
							Expression = "comp.RenderStart + floor((time - comp.RenderStart) / max(1, floor(comp:GetPrefs(\"Comp.FrameFormat.Rate\")/max(StopFPS,1) + 0.5))) * max(1, floor(comp:GetPrefs(\"Comp.FrameFormat.Rate\")/max(StopFPS,1) + 0.5))"
						},
						InterpolateBetweenFrames = Input { Value = 0 },
						SampleSpread = Input { Disabled = true },
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Fade"
						}
					}
				}
			
			},
