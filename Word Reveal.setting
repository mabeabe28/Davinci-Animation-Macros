{
	Tools = ordered() {
		WordReveal = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Text = InstanceInput { SourceOp = "WR_Text1", Source = "StyledText", Name = "Text", },
				Font = InstanceInput { SourceOp = "WR_Text1", Source = "Font", ControlGroup = 2, Default = "Michelangelus", },
				Style = InstanceInput { SourceOp = "WR_Text1", Source = "Style", ControlGroup = 2, Default = "Bold Italic", },
				Size = InstanceInput { SourceOp = "WR_Text1", Source = "Size", Name = "Size", Default = 0.0549, },
				Tracking = InstanceInput { SourceOp = "WR_Text1", Source = "CharacterSpacing", Name = "Tracking", Default = 1, },
				ColorR = InstanceInput { SourceOp = "WR_Text1", Source = "Red1", Name = "Color", ControlGroup = 6, Default = 1, },
				ColorG = InstanceInput { SourceOp = "WR_Text1", Source = "Green1", ControlGroup = 6, Default = 1, },
				ColorB = InstanceInput { SourceOp = "WR_Text1", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Position = InstanceInput { SourceOp = "WR_Text1", Source = "Center", Name = "Position", },
				StartDelay = InstanceInput { SourceOp = "WR_Text1", Source = "StartDelay", Name = "Start Delay (seconds)", Default = 0, },
				WordDelay = InstanceInput { SourceOp = "WR_Text1", Source = "WordDelay", Name = "Delay Between Words (seconds)", Default = 0.4, },
				FadeIn = InstanceInput { SourceOp = "WR_Text1", Source = "FadeIn", Name = "Word Fade (seconds)", Default = 0.3, },
				Rise = InstanceInput { SourceOp = "WR_Text1", Source = "Rise", Name = "Rise", Default = 0.02, },
				BlurAmt = InstanceInput { SourceOp = "WR_Text1", Source = "BlurAmt", Name = "Blur", Default = 5, },
				FadeOut = InstanceInput { SourceOp = "WR_Text1", Source = "FadeOut", Name = "Fade Out (seconds)", Default = 0.5, },
				StopFPS = InstanceInput { SourceOp = "WR_StopMotion", Source = "StopFPS", Name = "Stop Motion FPS", Default = 12, },
			},
			Outputs = {
				Output = InstanceOutput { SourceOp = "WR_StopMotion", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				WR_Text1 = TextPlus {
					UserControls = ordered() {
						StartDelay = {
							LINKID_DataType = "Number",
							INP_Default = 0,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxScale = 10,
							INP_MinScale = 0,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Start Delay (seconds)"
						},
						WordDelay = {
							LINKID_DataType = "Number",
							INP_Default = 0.4,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxScale = 2,
							INP_MinScale = 0,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Delay Between Words (seconds)"
						},
						FadeIn = {
							LINKID_DataType = "Number",
							INP_Default = 0.3,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0.04,
							INP_MaxScale = 3,
							INP_MinScale = 0.04,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Word Fade (seconds)"
						},
						Rise = {
							LINKID_DataType = "Number",
							INP_Default = 0.02,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxScale = 0.2,
							INP_MinScale = 0,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Rise"
						},
						BlurAmt = {
							LINKID_DataType = "Number",
							INP_Default = 5,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxScale = 30,
							INP_MinScale = 0,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Blur"
						},
						FadeOut = {
							LINKID_DataType = "Number",
							INP_Default = 0.5,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxScale = 5,
							INP_MinScale = 0,
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Fade Out (seconds)"
						}
					},
					Version = 1,
					Inputs = {
						Width = Input { Value = 3840 },
						Size = Input { Value = 0.0549 },
						Style = Input { Value = "Bold Italic" },
						UseFrameFormatSettings = Input { Value = 1 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Opacity1 = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 1, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 0 end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local p = ((time - comp.RenderStart) / fps - WR_Text1.StartDelay - (k - 1) * WR_Text1.WordDelay) / math.max(WR_Text1.FadeIn, 0.01); p = math.min(1, math.max(0, p)); return p * p * (3 - 2 * p)" },
						End = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 1, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k >= i then return 1 end; return (ul(string.sub(s, 1, b)) + 0.5) / len" },
						Start = Input { Expression = ":local s = WR_Text1.StyledText.Value or \"\"; local function ul(x) local _, n = string.gsub(x, \"[^\\128-\\191]\", \"\"); return n end; local k, N = 1, 12; local i, a, b = 0, nil, nil; for st, w, en in string.gmatch(s, \"()(%S+)()\") do i = i + 1; if i == k then a = st - 1 end; if i == k or (k == N and i > N) then b = en - 1 end end; local len = math.max(ul(s), 1); if not a then return 1 end; if k == 1 then return 0 end; return (ul(string.sub(s, 1, a)) - 0.5) / len" },
						StyledText = Input { Value = "There's something about Paris" },
						Wrap = Input { Value = 1 },
						Font = Input { Value = "Michelangelus" },
						Height = Input { Value = 2160 }
					}
				},
				WR_Blur1 = Blur {
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" } },
						XBlurSize = Input { Expression = "(1 - WR_Text1.Opacity1) * WR_Text1.BlurAmt" },
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Text1"
						}
					}
				},
				WR_Slide1 = Transform {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "WR_Blur1"
						},
						Center = Input { Expression = "Point(0.5, 0.5 - ((1 - WR_Text1.Opacity1)^2) * WR_Text1.Rise)" }
					}
				},
				WR_Clear = BrightnessContrast {
					Inputs = {
