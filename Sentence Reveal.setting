							Expression = ":local T = SR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 8, 16; local n = 0; for w in string.gmatch(s, \"%S+\") do n = n + 1 end; if k > n then return 0 end; if T.Anim ~= 0 then local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local p = ((time - comp.RenderStart) / fps - T.StartDelay - (k - 1) * T.WordDelay) / math.max(T.FadeIn, 0.01); p = math.min(1, math.max(0, p)); return p * p * (3 - 2 * p) end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local step = math.max(1, math.floor(fps / math.max(SR_StopMotion.StopFPS, 1) + 0.5)); local f0 = math.floor(T.StartDelay * fps / step + 0.5) * step; local d = math.floor(T.WordDelay * fps / step + 0.5) * step; local f = time - comp.RenderStart; if f >= f0 + (k - 1) * d then return 1 end; return 0",
