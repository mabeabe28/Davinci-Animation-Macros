, maxRows)); local gap = 0.5 * size; local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local function part(R) local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local bb, bc = math.huge, nil; for i = q - 1, j - 1 do local v = math.max(best[q - 1][i], cost(i + 1, j)); if v < bb then bb, bc = v, i end end; best[q][j] = bb; cut[q][j] = bc end end; local e, j = {}, n; for q = R, 1, -1 do e[q] = j; if q > 1 then j = cut[q][j] end end; return e end; local function fits(e) local f = 1; for q = 1, #e do local l = e[q]; if (pre[l + 1] - pre[f]) * wS * size + (l - f) * gap > safeW then return false end; f = l + 1 end; return true end; local R = T.JRows; local ends; if R >= 1 then R = math.min(n, R); ends = part(R) else R = math.min(n, maxRows, math.max(2, math.ceil(n / 3))); ends = part(R); while not fits(ends) and R < math.min(n, maxRows) do R = R + 1; ends = part(R) end end; local function rnd(i) local v = math.sin(i * 12.9898 + T.Seed * 78.233) * 43758.5453; return v - math.floor(v) end; local step = pitch; if R > 1 then step = math.max(pitch, (stackH - 0.617 * uY) / (R - 1)) end; local inkH = (R - 1) * step + 0.482 * uY; local top = (1 - P.Y) - inkH / 2; local maxTop = 1 - mY - inkH - 0.135 * uY; if top > maxTop then top = maxTop end; if top < mY then top = mY end; local first = 1; for q = 1, R do local last = ends[q]; if k >= first and k <= last then local c = last - first + 1; rtext = ws[k]; y = 1 - (top + (q - 1) * step + 0.217 * uY); if c == 1 then if (q + T.Seed) % 2 == 0 then side = -1; x = m else side = 1; x = 1 - mR end elseif k == first then side = -1; x = m elseif k == last then side = 1; x = 1 - mR else local tw, gs, gw = 0, 0, {}; for i = first, last do tw = tw + ew(ws[i]) * wS * size end; for jj = 1, c - 1 do gw[jj] = 0.25 + rnd(q * 11.3 + jj * 1.71); gs = gs + gw[jj] 