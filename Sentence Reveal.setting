maxRows = math.max(1, math.min(8, maxRows)); local R = math.min(n, maxRows); local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local bb, bc = math.huge, nil; for i = q - 1, j - 1 do local v = math.max(best[q - 1][i], cost(i + 1, j)); if v < bb then bb, bc = v, i end end; best[q][j] = bb; cut[q][j] = bc end end; local ends, j = {}, n; for q = R, 1, -1 do ends[q] = j; if q > 1 then j = cut[q][j] end end; local inkH = (R - 1) * pitch + 0.482 * uY; local top = (1 - P.Y) - inkH / 2; local maxTop = 1 - mY - inkH - 0.135 * uY; if top > maxTop then top = maxTop end; if top < mY then top = mY end; local st = T.Seed % 2147483647; if st <= 0 then st = st + 2147483646 end; local function ni(q) st = (st * 16807) % 2147483647; return (st % q) + 1 end; for _ = 1, 5 do ni(2) end; local colW = safeW / 6; local half = 3; local pS, pJ; local first = 1; for q = 1, R do local last = ends[q]; local parts = {}; for i = first, last do parts[#parts + 1] = ws[i] end; local text = table.concat(parts, \" \"); local wF = ew(text) * wS * size; local cands, total = {}, 0; for sd = -1, 1, 2 do for jj = 0, half - 1 do if jj * colW + wF <= safeW + 1e-6 and not (sd == pS and jj == pJ) then local wt = 2.5 ^ (half - 1 - jj); cands[#cands + 1] = {sd, jj, wt}; total = total + wt end end end; if #cands == 0 then cands = {{-1, 0, 1}}; total = 1 end; local roll = (ni(1000000) - 1) / 1000000 * total; local pick = cands[#cands]; for _, c in ipairs(cands) do if roll < c[3] then pick = c; break end; roll = roll - c[3] end; pS, pJ = pick[1], pick[2]; if k >= first and k <= last then rtext = text; side = pick[1]; if side < 0 then x = m + pick[2] * colW else x = 1 - mR - pick[2] * colW end; y = 1 - (top + (q - 1) * pitch + 0.217 * uY); local pos = 0; for i = first, k do if i == k then a = pos; b = pos + ul(ws[i]) end; pos = pos + ul(ws[i]) + 1 end; rlen = ul(text); jf = (k == first); jl = (k == last) end; first = last + 1 end end end; return rtext or \"\"" },
						Center = Input { Expression = ":local T = SR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 4, 16; if T.Scatter == 0 then return Point(T.Position.X, T.Position.Y) end; local P = T.Position; local W = comp:GetPrefs(\"Comp.FrameFormat.Width\"); local H = comp:GetPrefs(\"Comp.FrameFormat.Height\"); local function ul(x) local _, c = string.gsub(x, \"[^\\128-\\191]\", \"\"); return c end; local function ew(x) local w = 0; for ch in string.gmatch(x, \"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do if #ch > 1 then if ch == \"\\226\\128\\153\" or ch == \"\\226\\128\\152\" then w = w + 0.14 else w = w + 0.38 end elseif ch == \" \" then w = w + 0.17 elseif string.find(ch, \"[ilIj',%.!:;|]\") then w = w + 0.14 elseif string.find(ch, \"[tfr]\") then w = w + 0.24 elseif string.find(ch, \"[mw]\") then w = w + 0.52 elseif string.find(ch, \"[MW]\") then w = w + 0.58 elseif string.find(ch, \"%u\") then w = w + 0.42 elseif string.find(ch, \"%d\") then w = w + 0.36 else w = w + 0.35 end end; return w end; local ws = {}; for w in string.gmatch(s, \"%S+\") do if #ws < N then ws[#ws + 1] = w else ws[N] = ws[N] .. \" \" .. w end end; local n = #ws; local rtext, a, b, rlen, jf, jl, side, x, y; if k <= n then local size = T.Size; local m = T.Margin; local mR = m; if H / W >= 1.6 then mR = math.max(m, 0.12) end; local mY = 0.10; local safeW = 1 - m - mR; local wS = (T.CharacterSpacing / 0.958) * 1.2; local uY = size * W / H; local pitch = 0.78 * uY; if T.Justify ~= 0 then local stackH = math.min(T.StackH, 1 - 2 * mY); local maxRows = math.floor((stackH / uY - 0.482 - 0.135) / 0.78 + 1e-6) + 1; maxRows = math.max(1, math.min(8, maxRows)); local gap = 0.5 * size; local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local function part(R) local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local