				SR_Slide15 = Transform {
					Inputs = {
						Center = Input { Expression = ":local T = SR_Text1; local e = ((1 - SR_Text15.Opacity1)^2) * T.Rise; local d = T.SlideDir; local ex = e * comp:GetPrefs(\"Comp.FrameFormat.Height\") / comp:GetPrefs(\"Comp.FrameFormat.Width\"); if d == 0 then return Point(0.5 + ex, 0.5) elseif d == 1 then return Point(0.5 - ex, 0.5) elseif d == 2 then return Point(0.5, 0.5 + e) end; return Point(0.5, 0.5 - e)", },
