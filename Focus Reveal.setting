{
	Tools = ordered() {
		FocusReveal = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Text = InstanceInput { SourceOp = "FR_Text1", Source = "Sentence", Name = "Text", },
				Font = InstanceInput { SourceOp = "FR_Text1", Source = "Font", ControlGroup = 2, },
				Style = InstanceInput { SourceOp = "FR_Text1", Source = "Style", ControlGroup = 2, },
				Size = InstanceInput { SourceOp = "FR_Text1", Source = "Size", Name = "Size", Default = 0.07, },
				Tracking = InstanceInput { SourceOp = "FR_Text1", Source = "CharacterSpacing", Name = "Tracking", Default = 1, },
				ColorR = InstanceInput { SourceOp = "FR_Text1", Source = "Red1", Name = "Color", ControlGroup = 6, Default = 0.96, },
				ColorG = InstanceInput { SourceOp = "FR_Text1", Source = "Green1", ControlGroup = 6, Default = 0.95, },
				ColorB = InstanceInput { SourceOp = "FR_Text1", Source = "Blue1", ControlGroup = 6, Default = 0.92, },
				Position = InstanceInput { SourceOp = "FR_Text1", Source = "Position", Name = "Position", },
				StartDelay = InstanceInput { SourceOp = "FR_Text1", Source = "StartDelay", Name = "Start Delay (seconds)", Default = 0.25, },
				WordDelay = InstanceInput { SourceOp = "FR_Text1", Source = "WordDelay", Name = "Delay Between Words (seconds)", Default = 0.3, },
				FocusDelay = InstanceInput { SourceOp = "FR_Text1", Source = "FocusDelay", Name = "Hold Blurred After Last Word (seconds)", Default = 0.3, },
				FocusTime = InstanceInput { SourceOp = "FR_Text1", Source = "FocusTime", Name = "Focus Pull (seconds)", Default = 1.2, },
				BlurAmt = InstanceInput { SourceOp = "FR_Text1", Source = "BlurAmt", Name = "Blur", Default = 4, },
				FadeOut = InstanceInput { SourceOp = "FR_Text1", Source = "FadeOut", Name = "Fade Out (seconds)", Default = 0, },
				Scatter = InstanceInput { SourceOp = "FR_Text1", Source = "Scatter", Name = "Scatter", Default = 0, },
				Justify = InstanceInput { SourceOp = "FR_Text1", Source = "Justify", Name = "Scatter Justified", Default = 0, },
				JRows = InstanceInput { SourceOp = "FR_Text1", Source = "JRows", Name = "Scatter Justified Rows (0 = auto)", Default = 0, },
				Seed = InstanceInput { SourceOp = "FR_Text1", Source = "Seed", Name = "Scatter Seed", Default = 1, },
				Margin = InstanceInput { SourceOp = "FR_Text1", Source = "Margin", Name = "Scatter Margin", Default = 0.08, },
				StackH = InstanceInput { SourceOp = "FR_Text1", Source = "StackH", Name = "Scatter Stack Height", Default = 0.55, },
				StopFPS = InstanceInput { SourceOp = "FR_StopMotion", Source = "StopFPS", Name = "Stop Motion FPS", Default = 24, },
			},
			Outputs = {
				Output = InstanceOutput { SourceOp = "FR_StopMotion", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				FR_Clear = Background {
					ViewInfo = OperatorInfo { Pos = { -55, 181.5 } },
					Inputs = {
						TopLeftAlpha = Input { Value = 0 },
						Height = Input { Value = 2160 },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 3840 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
					}
				},
				FR_Text1 = TextPlus {
					ViewInfo = OperatorInfo { Pos = { 55, 148.5 } },
					Inputs = {
						StyledText = Input {
							Expression = ":local T = FR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 1, 16; if T.Scatter == 0 then return s end; local P = T.Position; local W = comp:GetPrefs(\"Comp.FrameFormat.Width\"); local H = comp:GetPrefs(\"Comp.FrameFormat.Height\"); local function ul(x) local _, c = string.gsub(x, \"[^\\128-\\191]\", \"\"); return c end; local function ew(x) local w = 0; for ch in string.gmatch(x, \"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do if #ch > 1 then if ch == \"\\226\\128\\153\" or ch == \"\\226\\128\\152\" then w = w + 0.14 else w = w + 0.38 end elseif ch == \" \" then w = w + 0.17 elseif string.find(ch, \"[ilIj',%.!:;|]\") then w = w + 0.14 elseif string.find(ch, \"[tfr]\") then w = w + 0.24 elseif string.find(ch, \"[mw]\") then w = w + 0.52 elseif string.find(ch, \"[MW]\") then w = w + 0.58 elseif string.find(ch, \"%u\") then w = w + 0.42 elseif string.find(ch, \"%d\") then w = w + 0.36 else w = w + 0.35 end end; return w end; local ws = {}; for w in string.gmatch(s, \"%S+\") do if #ws < N then ws[#ws + 1] = w else ws[N] = ws[N] .. \" \" .. w end end; local n = #ws; local rtext, a, b, rlen, jf, jl, side, x, y; if k <= n then local size = T.Size; local m = T.Margin; local mR = m; if H / W >= 1.6 then mR = math.max(m, 0.12) end; local mY = 0.10; local safeW = 1 - m - mR; local wS = (T.CharacterSpacing / 0.958) * 1.2; local uY = size * W / H; local pitch = 0.78 * uY; if T.Justify ~= 0 then local stackH = math.min(T.StackH, 1 - 2 * mY); local maxRows = math.floor((stackH / uY - 0.482 - 0.135) / 0.78 + 1e-6) + 1; maxRows = math.max(1, math.min(8, maxRows)); local gap = 0.5 * size; local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local function part(R) local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local bb, bc = math.huge, nil; for i = q - 1, j - 1 do local v = math.max(best[q - 1][i], cost(i + 1, j)); if v < bb then bb, bc = v, i end end; best[q][j] = bb; cut[q][j] = bc end end; local e, j = {}, n; for q = R, 1, -1 do e[q] = j; if q > 1 then j = cut[q][j] end end; return e end; local function fits(e) local f = 1; for q = 1, #e do local l = e[q]; if (pre[l + 1] - pre[f]) * wS * size + (l - f) * gap > safeW then return false end; f = l + 1 end; return true end; local R = T.JRows; local ends; if R >= 1 then R = math.min(n, R); ends = part(R) else R = math.min(n, maxRows, math.max(2, math.ceil(n / 3))); ends = part(R); while not fits(ends) and R < math.min(n, maxRows) do R = R + 1; ends = part(R) end end; local function rnd(i) local v = math.sin(i * 12.9898 + T.Seed * 78.233) * 43758.5453; return v - math.floor(v) end; local step = pitch; if R > 1 then step = math.max(pitch, (stackH - 0.617 * uY) / (R - 1)) end; local inkH = (R - 1) * step + 0.482 * uY; local top = (1 - P.Y) - inkH / 2; local maxTop = 1 - mY - inkH - 0.135 * uY; if top > maxTop then top = maxTop end; if top < mY then top = mY end; local first = 1; for q = 1, R do local last = ends[q]; if k >= first and k <= last then local c = last - first + 1; rtext = ws[k]; y = 1 - (top + (q - 1) * step + 0.217 * uY); if c == 1 then if (q + T.Seed) % 2 == 0 then side = -1; x = m else side = 1; x = 1 - mR end elseif k == first then side = -1; x = m elseif k == last then side = 1; x = 1 - mR else local tw, gs, gw = 0, 0, {}; for i = first, last do tw = tw + ew(ws[i]) * wS * size end; for jj = 1, c - 1 do gw[jj] = 0.25 + rnd(q * 11.3 + jj * 1.71); gs = gs + gw[jj] end; local L = math.max(0, safeW - tw - (c - 1) * gap); local xx = m; for i = first, k do local we = ew(ws[i]) * wS * size; if i == k then x = xx + we / 2; break end; xx = xx + we + gap + L * gw[i - first + 1] / gs end; side = 0 end end; first = last + 1 end else local stackH = math.min(T.StackH, 1 - 2 * mY); local maxRows = math.floor((stackH / uY - 0.482 - 0.135) / 0.78 + 1e-6) + 1; maxRows = math.max(1, math.min(8, maxRows)); local R = math.min(n, maxRows); local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local bb, bc = math.huge, nil; for i = q - 1, j - 1 do local v = math.max(best[q - 1][i], cost(i + 1, j)); if v < bb then bb, bc = v, i end end; best[q][j] = bb; cut[q][j] = bc end end; local ends, j = {}, n; for q = R, 1, -1 do ends[q] = j; if q > 1 then j = cut[q][j] end end; local inkH = (R - 1) * pitch + 0.482 * uY; local top = (1 - P.Y) - inkH / 2; local maxTop = 1 - mY - inkH - 0.135 * uY; if top > maxTop then top = maxTop end; if top < mY then top = mY end; local st = T.Seed % 2147483647; if st <= 0 then st = st + 2147483646 end; local function ni(q) st = (st * 16807) % 2147483647; return (st % q) + 1 end; for _ = 1, 5 do ni(2) end; local colW = safeW / 6; local half = 3; local pS, pJ; local first = 1; for q = 1, R do local last = ends[q]; local parts = {}; for i = first, last do parts[#parts + 1] = ws[i] end; local text = table.concat(parts, \" \"); local wF = ew(text) * wS * size; local cands, total = {}, 0; for sd = -1, 1, 2 do for jj = 0, half - 1 do if jj * colW + wF <= safeW + 1e-6 and not (sd == pS and jj == pJ) then local wt = 2.5 ^ (half - 1 - jj); cands[#cands + 1] = {sd, jj, wt}; total = total + wt end end end; if #cands == 0 then cands = {{-1, 0, 1}}; total = 1 end; local roll = (ni(1000000) - 1) / 1000000 * total; local pick = cands[#cands]; for _, c in ipairs(cands) do if roll < c[3] then pick = c; break end; roll = roll - c[3] end; pS, pJ = pick[1], pick[2]; if k >= first and k <= last then rtext = text; side = pick[1]; if side < 0 then x = m + pick[2] * colW else x = 1 - mR - pick[2] * colW end; y = 1 - (top + (q - 1) * pitch + 0.217 * uY); local pos = 0; for i = first, k do if i == k then a = pos; b = pos + ul(ws[i]) end; pos = pos + ul(ws[i]) + 1 end; rlen = ul(text); jf = (k == first); jl = (k == last) end; first = last + 1 end end end; return rtext or \"\"",
							Value = "The words arrive out of focus"
						},
						Center = Input { Expression = ":local T = FR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 1, 16; if T.Scatter == 0 then return Point(T.Position.X, T.Position.Y) end; local P = T.Position; local W = comp:GetPrefs(\"Comp.FrameFormat.Width\"); local H = comp:GetPrefs(\"Comp.FrameFormat.Height\"); local function ul(x) local _, c = string.gsub(x, \"[^\\128-\\191]\", \"\"); return c end; local function ew(x) local w = 0; for ch in string.gmatch(x, \"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do if #ch > 1 then if ch == \"\\226\\128\\153\" or ch == \"\\226\\128\\152\" then w = w + 0.14 else w = w + 0.38 end elseif ch == \" \" then w = w + 0.17 elseif string.find(ch, \"[ilIj',%.!:;|]\") then w = w + 0.14 elseif string.find(ch, \"[tfr]\") then w = w + 0.24 elseif string.find(ch, \"[mw]\") then w = w + 0.52 elseif string.find(ch, \"[MW]\") then w = w + 0.58 elseif string.find(ch, \"%u\") then w = w + 0.42 elseif string.find(ch, \"%d\") then w = w + 0.36 else w = w + 0.35 end end; return w end; local ws = {}; for w in string.gmatch(s, \"%S+\") do if #ws < N then ws[#ws + 1] = w else ws[N] = ws[N] .. \" \" .. w end end; local n = #ws; local rtext, a, b, rlen, jf, jl, side, x, y; if k <= n then local size = T.Size; local m = T.Margin; local mR = m; if H / W >= 1.6 then mR = math.max(m, 0.12) end; local mY = 0.10; local safeW = 1 - m - mR; local wS = (T.CharacterSpacing / 0.958) * 1.2; local uY = size * W / H; local pitch = 0.78 * uY; if T.Justify ~= 0 then local stackH = math.min(T.StackH, 1 - 2 * mY); local maxRows = math.floor((stackH / uY - 0.482 - 0.135) / 0.78 + 1e-6) + 1; maxRows = math.max(1, math.min(8, maxRows)); local gap = 0.5 * size; local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local function part(R) local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local