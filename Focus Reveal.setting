						HorizontalJustificationNew = Input { Value = 3 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalLeftCenterRight = Input { Expression = ":local T = FR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 15, 16; if T.Scatter == 0 then return 0 end; local P = T.Position; local W = comp:GetPrefs(\"Comp.FrameFormat.Width\"); local H = comp:GetPrefs(\"Comp.FrameFormat.Height\"); local function ul(x) local _, c = string.gsub(x, \"[^\\128-\\191]\", \"\"); return c end; local function ew(x) local w = 0; for ch in string.gmatch(x, \"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do if #ch > 1 then if ch == \"\\226\\128\\153\" or ch == \"\\226\\128\\152\" then w = w + 0.14 else w = w + 0.38 end elseif ch == \" \" then w = w + 0.17 elseif string.find(ch, \"[ilIj',%.!:;|]\") then w = w + 0.14 elseif string.find(ch, \"[tfr]\") then w = w + 0.24 elseif string.find(ch, \"[mw]\") then w = w + 0.52 elseif string.find(ch, \"[MW]\") then w = w + 0.58 elseif string.find(ch, \"%u\") then w = w + 0.42 elseif string.find(ch, \"%d\") then w = w + 0.36 else w = w + 0.35 end end; return w end; local ws = {}; for w in string.gmatch(s, \"%S+\") do if #ws < N then ws[#ws + 1] = w else ws[N] = ws[N] .. \" \" .. w end end; local n = #ws; local rtext, a, b, rlen, jf, jl, side, x, y; if k <= n then local size = T.Size; local m = T.Margin; local mR = m; if H / W >= 1.6 then mR = math.max(m, 0.12) end; local mY = 0.10; local safeW = 1 - m - mR; local wS = (T.CharacterSpacing / 0.958) * 1.2; local uY = size * W / H; local pitch = 0.78 * uY; if T.Justify ~= 0 then local stackH = math.min(T.StackH, 1 - 2 * mY); local maxRows = math.floor((stackH / uY - 0.482 - 0.135) / 0.78 + 1e-6) + 1; maxRows = math.max(1, math.min(8, maxRows)); local gap = 0.5 * size; local pre = {0}; for i = 1, n do pre[i + 1] = pre[i] + ew(ws[i]) end; local function cost(i, j) return pre[j + 1] - pre[i] + 0.17 * (j - i) end; local function part(R) local best, cut = {}, {}; for q = 1, R do best[q] = {}; cut[q] = {} end; for j = 1, n do best[1][j] = cost(1, j) end; for q = 2, R do for j = q, n do local bb, bc = ma