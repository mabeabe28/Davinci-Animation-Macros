						Opacity1 = Input { Expression = ":local T = FR_Text1; local s = T.Sentence.Value or \"\"; local k, N = 6, 16; local n = 0; for w in string.gmatch(s, \"%S+\") do n = n + 1 end; if k > n then return 0 end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local step = math.max(1, math.floor(fps / math.max(FR_StopMotion.StopFPS, 1) + 0.5)); local f0 = math.floor(T.StartDelay * fps / step + 0.5) * step; local d = math.floor(T.WordDelay * fps / step + 0.5) * step; local f = time - comp.RenderStart; if f >= f0 + (k - 1) * d then return 1 end; return 0" },
