						CharacterSpacing = Input { Expression = "FR_Text1.CharacterSpacing" },
						UseFrameFormatSettings = Input { Value = 1 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 2160 },
						Wrap = Input { Value = 1 }
					}
				},
				FR_Join16 = Merge {
					ViewInfo = OperatorInfo { Pos = { 1705, 181.5 } },
					Inputs = {
						Foreground = Input {
							SourceOp = "FR_Text16",
							Source = "Output"
						},
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {
							SourceOp = "FR_Join15",
							Source = "Output"
						}
					}
				},
				FR_Blur = Blur {
					ViewInfo = OperatorInfo { Pos = { 1925, 181.5 } },
					Inputs = {
						Input = Input {
							SourceOp = "FR_Join16",
							Source = "Output"
						},
						XBlurSize = Input {
							Expression = ":local T = FR_Text1; local s = T.Sentence.Value or \"\"; local n = 0; for w in string.gmatch(s, \"%S+\") do n = n + 1 end; if n > 16 then n = 16 end; local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local step = math.max(1, math.floor(fps / math.max(FR_StopMotion.StopFPS, 1) + 0.5)); local f0 = math.floor(T.StartDelay * fps / step + 0.5) * step; local d = math.floor(T.WordDelay * fps / step + 0.5) * step; local f = time - comp.RenderStart; local t0 = f0 + math.max(n - 1, 0) * d + T.FocusDelay * fps; local p = math.min(1, math.max(0, (f - t0) / math.max(T.FocusTime * fps, 1))); p = p * p * (3 - 2 * p); return T.BlurAmt * (1 - p)",
							Value = 1.38888888888889
						},
						Filter = Input { Value = FuID { "Fast Gaussian" } }
					}
				},
				FR_Fade = Merge {
					ViewInfo = OperatorInfo { Pos = { 2035, 181.5 } },
					Inputs = {
						Foreground = Input {
							SourceOp = "FR_Blur",
							Source = "Output"
						},
						Background = Input {
							SourceOp = "FR_Clear",
							Source = "Output"
						},
						PerformDepthMerge = Input { Value = 0 },
						Blend = Input { Expression = ":local fps = comp:GetPrefs(\"Comp.FrameFormat.Rate\"); local step = math.max(1, math.floor(fps / math.max(FR_StopMotion.StopFPS, 1) + 0.5)); local last = comp.RenderStart + math.floor((comp.RenderEnd - comp.RenderStart) / step) * step; if FR_Text1.FadeOut <= 0 then return 1 end; local b = math.min(1, math.max(0, (last - time) / (FR_Text1.FadeOut * fps))); return b * b * (3 - 2 * b)" }
					}
				},
				FR_StopMotion = TimeStretcher {
					UserControls = {
						StopFPS = {
							LINKID_DataType = "Number",
							LINKS_Name = "Stop Motion FPS",
							ICS_ControlPage = "Reveal",
							INPID_InputControl = "SliderControl",
							INP_Default = 24,
							INP_MinAllowed = 1,
							INP_MaxScale = 60,
							INP_MinScale = 1
						}
					},
					ViewInfo = OperatorInfo { Pos = { 2145, 181.5 } },
					Inputs = {
						SampleSpread = Input { Disabled = true },
						SourceTime = Input {
							Expression = "comp.RenderStart + floor((time - comp.RenderStart) / max(1, floor(comp:GetPrefs(\"Comp.FrameFormat.Rate\")/max(StopFPS,1) + 0.5))) * max(1, floor(comp:GetPrefs(\"Comp.FrameFormat.Rate\")/max(StopFPS,1) + 0.5))",
							Value = 58
						},
						Input = Input {
							SourceOp = "FR_Fade",
							Source = "Output"
						},
						InterpolateBetweenFrames = Input { Value = 0 }
					}
				}
			},
		},
	},
	ActiveTool = "FocusReveal",
}
