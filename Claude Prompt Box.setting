						LightText = { LINKS_Name = "Light Text Outside Box", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 0, INPID_InputControl = "CheckboxControl", INP_Integer = true, CBC_TriState = false, },
						FW = { LINKS_Name = "FW", LINKID_DataType = "Number", ICS_ControlPage = "Internal", INP_Default = 1920, INPID_InputControl = "ScrewControl", INP_MinScale = 0, INP_MaxScale = 1, },
