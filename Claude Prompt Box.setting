						FFootL = { LINKS_Name = "FFootL", LINKID_DataType = "Number", ICS_ControlPage = "Internal", INP_Default = 0, INPID_InputControl = "ScrewControl", INP_MinScale = 0, INP_MaxScale = 1, },
