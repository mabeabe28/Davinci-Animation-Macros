						K = { LINKS_Name = "K", LINKID_DataType = "Number", ICS_ControlPage = "Internal", INP_Default = 0.000774, INPID_InputControl = "ScrewControl", INP_MinScale = 0, INP_MaxScale = 1, },
						KY = { LINKS_Name = "KY", LINKID_DataType = "Number", ICS_ControlPage = "Internal", INP_Default = 0.001376, INPID_InputControl = "ScrewControl", INP_MinScale = 0, INP_MaxScale = 1, },
