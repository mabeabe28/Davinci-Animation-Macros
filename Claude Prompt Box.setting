{
	Tools = ordered() {
		ClaudePromptBox = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Greeting = InstanceInput { SourceOp = "CPB_Greeting", Source = "StyledText", Name = "Greeting", Page = "Controls", },
				Prompt = InstanceInput { SourceOp = "CPB_PromptSrc", Source = "StyledText", Name = "Prompt", },
				Placeholder = InstanceInput { SourceOp = "CPB_Placeholder", Source = "StyledText", Name = "Placeholder", },
				Model = InstanceInput { SourceOp = "CPB_Model", Source = "StyledText", Name = "Model Name", },
				Effort = InstanceInput { SourceOp = "CPB_Effort", Source = "StyledText", Name = "Effort Label", },
				Mode = InstanceInput { SourceOp = "CPB_Mode", Source = "StyledText", Name = "Mode Label", },
				Project = InstanceInput { SourceOp = "CPB_Project", Source = "StyledText", Name = "Left Label", },
				Speed = InstanceInput { SourceOp = "CPB_Ctrl", Source = "Speed", Page = "Animation", Default = 1, },
				TypeOn = InstanceInput { SourceOp = "CPB_Ctrl", Source = "TypeOn", Default = 1, },
				TypeDelay = InstanceInput { SourceOp = "CPB_Ctrl", Source = "TypeDelay", Default = 1.1, },
				TypeSpeed = InstanceInput { SourceOp = "CPB_Ctrl", Source = "TypeSpeed", Default = 50, },
				KeepCentered = InstanceInput { SourceOp = "CPB_Ctrl", Source = "KeepCentered", Default = 1, },
				ShowSend = InstanceInput { SourceOp = "CPB_Ctrl", Source = "ShowSend", Default = 1, },
				SendAnim = InstanceInput { SourceOp = "CPB_Ctrl", Source = "SendAnim", Default = 1, },
				SendAt = InstanceInput { SourceOp = "CPB_Ctrl", Source = "SendAt", Default = 3.8, },
				Scale = InstanceInput { SourceOp = "CPB_Ctrl", Source = "Scale", Page = "Layout", Default = 1, },
				Position = InstanceInput { SourceOp = "CPB_Out", Source = "Center", Name = "Position", },
				GreetSize = InstanceInput { SourceOp = "CPB_Ctrl", Source = "GreetSize", Default = 1, },
				GreetFont = InstanceInput { SourceOp = "CPB_Greeting", Source = "Font", Name = "Greeting Font", ControlGroup = 21, },
				GreetStyle = InstanceInput { SourceOp = "CPB_Greeting", Source = "Style", ControlGroup = 21, },
				UIFont = InstanceInput { SourceOp = "CPB_Placeholder", Source = "Font", Name = "Interface Font", ControlGroup = 22, },
				UIStyle = InstanceInput { SourceOp = "CPB_Placeholder", Source = "Style", ControlGroup = 22, },
				BGOpacity = InstanceInput { SourceOp = "CPB_BGMerge", Source = "Blend", Name = "Background Opacity", Default = 1, },
				BGRed = InstanceInput { SourceOp = "CPB_BG", Source = "TopLeftRed", Name = "Background Color", ControlGroup = 23, Default = 0.980392, },
				BGGreen = InstanceInput { SourceOp = "CPB_BG", Source = "TopLeftGreen", ControlGroup = 23, Default = 0.976471, },
				BGBlue = InstanceInput { SourceOp = "CPB_BG", Source = "TopLeftBlue", ControlGroup = 23, Default = 0.960784, },
				LightText = InstanceInput { SourceOp = "CPB_Ctrl", Source = "LightText", Default = 0, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "CPB_Out", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				CPB_Ctrl = Background {
					CtrlWZoom = false,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
						Speed = Input { Value = 1, },
						TypeOn = Input { Value = 1, },
						TypeDelay = Input { Value = 1.1, },
						TypeSpeed = Input { Value = 50, },
						Scale = Input { Value = 1, },
						KeepCentered = Input { Value = 1, },
						ShowSend = Input { Value = 1, },
						SendAnim = Input { Value = 1, },
						SendAt = Input { Value = 3.8, },
						GreetSize = Input { Value = 1, },
						LightText = Input { Value = 0, },
						FW = Input { Value = 1920, Expression = "comp:GetPrefs(\"Comp.FrameFormat.Width\") or 1920", },
						FH = Input { Value = 1080, Expression = "comp:GetPrefs(\"Comp.FrameFormat.Height\") or 1080", },
						FPS = Input { Value = 24, Expression = "comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24", },
						Asp = Input { Value = 1.777778, Expression = "FW / FH", },
						T = Input { Value = 0, Expression = "(time - comp.RenderStart) / FPS * Speed", },
						K = Input { Value = 0.000774, Expression = "math.min(0.86, 0.6933 / math.sqrt(Asp)) / 672 * Scale", },
						KY = Input { Value = 0.001376, Expression = "K * Asp", },
						Total = Input { Value = 0, Expression = ":local s = CPB_PromptSrc.StyledText.Value or \"\"; return select(2, string.gsub(s, \"[^\\128-\\191]\", \"\"))", },
						NTyped = Input { Value = 0, Expression = "TypeOn == 0 and Total or math.min(Total, math.floor(math.max(0, (T - TypeDelay) * TypeSpeed)))", },
						HasText = Input { Value = 0, Expression = "NTyped > 0 and 1 or 0", },
						L0 = Input { Value = 1, Expression = ":local o = CPB_M0.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						L1 = Input { Value = 1, Expression = ":local o = CPB_M1.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						L2 = Input { Value = 1, Expression = ":local o = CPB_M2.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						L3 = Input { Value = 1, Expression = ":local o = CPB_M3.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						L4 = Input { Value = 1, Expression = ":local o = CPB_M4.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						L5 = Input { Value = 1, Expression = ":local o = CPB_M5.Output; local d = o.DataWindow; if (not d) or d.top <= d.bottom then return 1 end; return math.floor(((d.top - d.bottom) / o.Width / K) / 24 + 0.05) + 1", },
						Lines = Input { Value = 1, Expression = "(L0 + 2 * L1 + 3 * L2 + 3 * L3 + 2 * L4 + L5) / 12", },
						BoxH = Input { Value = 108, Expression = "60 + math.max(48, 24 * Lines + 12)", },
						BoxTop = Input { Value = 39.5, Expression = "KeepCentered == 1 and (BoxH / 2 - 14.5) or 39.5", },
						BoxBot = Input { Value = -68.5, Expression = "BoxTop - BoxH", },
						PLogo = Input { Value = 0, Expression = "(1 + 2.70158 * (math.min(1, math.max(0, (T - 0) / 0.6)) - 1)^3 + 1.70158 * (math.min(1, math.max(0, (T - 0) / 0.6)) - 1)^2)", },
						RLogo = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 0) / 0.75)))^3)", },
						FLogo = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0) / 0.15))", },
						PGreet = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 0.15) / 0.7)))^3)", },
						FGreet = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.15) / 0.3))", },
						PBox = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 0.3) / 0.7)))^5)", },
						FBox = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.3) / 0.3))", },
						PHint = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 0.62) / 0.4)))^3)", },
						FHint = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.62) / 0.3))", },
						PPlus = Input { Value = 0, Expression = "(1 + 2.70158 * (math.min(1, math.max(0, (T - 0.72) / 0.4)) - 1)^3 + 1.70158 * (math.min(1, math.max(0, (T - 0.72) / 0.4)) - 1)^2)", },
						FPlus = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.72) / 0.15))", },
						PMic = Input { Value = 0, Expression = "(1 + 2.70158 * (math.min(1, math.max(0, (T - 0.8) / 0.4)) - 1)^3 + 1.70158 * (math.min(1, math.max(0, (T - 0.8) / 0.4)) - 1)^2)", },
						FMic = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.8) / 0.15))", },
						PVoice = Input { Value = 0, Expression = "(1 + 2.70158 * (math.min(1, math.max(0, (T - 0.88) / 0.4)) - 1)^3 + 1.70158 * (math.min(1, math.max(0, (T - 0.88) / 0.4)) - 1)^2)", },
						FVoice = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.88) / 0.15))", },
						PFootL = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 0.92) / 0.45)))^3)", },
						FFootL = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 0.92) / 0.3))", },
						PFootR = Input { Value = 0, Expression = "(1 - (1 - math.min(1, math.max(0, (T - 1) / 0.45)))^3)", },
						FFootR = Input { Value = 0, Expression = "math.min(1, math.max(0, (T - 1) / 0.3))", },
						SendRaw = Input { Value = 0, Expression = ":if ShowSend == 0 or Total == 0 then return 0 end; if TypeOn == 0 then return math.min(1, math.max(0, (T - 0.88) / 0.4)) end; return math.min(1, math.max(0, (T - TypeDelay - 1 / math.max(1, TypeSpeed)) / 0.3))", },
						PSend = Input { Value = 0, Expression = "(1 + 2.70158 * (SendRaw - 1)^3 + 1.70158 * (SendRaw - 1)^2)", },
						CaretOn = Input { Value = 0, Expression = ":if TypeOn == 0 or T < 1.0 then return 0 end; local e = TypeDelay + Total / math.max(1, TypeSpeed); if T < TypeDelay then return ((TypeDelay - T) % 1.06) < 0.53 and 1 or 0 end; if T < e then return 1 end; return ((T - e) % 1.06) < 0.53 and 1 or 0", },
						TS = Input { Value = -1, Expression = "SendAnim == 1 and (T - SendAt) or -1", },
						Press = Input { Value = 0, Expression = "TS < 0 and 0 or math.sin(math.pi * math.min(1, TS / 0.2))", },
						RipS = Input { Value = 1, Expression = ":local r = math.min(1, math.max(0, (TS - 0.07) / 0.38)); return 1 + 0.55 * (1 - (1 - r)^3)", },
						RipA = Input { Value = 0, Expression = ":if TS < 0.07 then return 0 end; return 0.32 * (1 - math.min(1, (TS - 0.07) / 0.38))", },
						FOutUI = Input { Value = 0, Expression = "math.min(1, math.max(0, (TS - 0.16) / 0.28))", },
						FOutGreet = Input { Value = 0, Expression = "math.min(1, math.max(0, (TS - 0.12) / 0.26))", },
						TL = Input { Value = 0, Expression = "math.max(0, TS - 0.62)", },
						DF1 = Input { Value = 0, Expression = "math.min(1, math.max(0, (TS - 0.40) / 0.12))", },
						DP1 = Input { Value = 0, Expression = ":local u = math.min(1, math.max(0, (TS - 0.40) / 0.3)); return 1 + 2.70158 * (u - 1)^3 + 1.70158 * (u - 1)^2", },
						DW1 = Input { Value = 0, Expression = ":local p = (TL - 0.00) % 1; if TL <= 0 or p > 0.5 then return 0 end; return 0.5 - 0.5 * math.cos(p * 4 * math.pi)", },
						DF2 = Input { Value = 0, Expression = "math.min(1, math.max(0, (TS - 0.47) / 0.12))", },
						DP2 = Input { Value = 0, Expression = ":local u = math.min(1, math.max(0, (TS - 0.47) / 0.3)); return 1 + 2.70158 * (u - 1)^3 + 1.70158 * (u - 1)^2", },
						DW2 = Input { Value = 0, Expression = ":local p = (TL - 0.15) % 1; if TL <= 0 or p > 0.5 then return 0 end; return 0.5 - 0.5 * math.cos(p * 4 * math.pi)", },
						DF3 = Input { Value = 0, Expression = "math.min(1, math.max(0, (TS - 0.54) / 0.12))", },
						DP3 = Input { Value = 0, Expression = ":local u = math.min(1, math.max(0, (TS - 0.54) / 0.3)); return 1 + 2.70158 * (u - 1)^3 + 1.70158 * (u - 1)^2", },
						DW3 = Input { Value = 0, Expression = ":local p = (TL - 0.30) % 1; if TL <= 0 or p > 0.5 then return 0 end; return 0.5 - 0.5 * math.cos(p * 4 * math.pi)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Speed = { LINKS_Name = "Animation Speed", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1, INPID_InputControl = "SliderControl", INP_MinScale = 0.25, INP_MaxScale = 3, INP_MinAllowed = 0.25, },
						TypeOn = { LINKS_Name = "Type On Prompt", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1, INPID_InputControl = "CheckboxControl", INP_Integer = true, CBC_TriState = false, },
						TypeDelay = { LINKS_Name = "Typing Starts At (s)", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1.1, INPID_InputControl = "SliderControl", INP_MinScale = 0, INP_MaxScale = 6, INP_MinAllowed = 0, },
						TypeSpeed = { LINKS_Name = "Typing Speed (chars/s)", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 50, INPID_InputControl = "SliderControl", INP_MinScale = 5, INP_MaxScale = 80, INP_MinAllowed = 5, },
						Scale = { LINKS_Name = "Scale", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1, INPID_InputControl = "SliderControl", INP_MinScale = 0.3, INP_MaxScale = 2.5, INP_MinAllowed = 0.3, },
						KeepCentered = { LINKS_Name = "Keep Centered As Box Grows", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1, INPID_InputControl = "CheckboxControl", INP_Integer = true, CBC_TriState = false, },
						ShowSend = { LINKS_Name = "Show Send Button", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INP_Default = 1, INPID_InputControl = "CheckboxControl", INP_Integer = true, CBC_TriState = false, },
